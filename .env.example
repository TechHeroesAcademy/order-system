# ─── database ───────────────────────────────────────────────────────────
# Neon's POOLED connection string — the host with "-pooler" in it. The app
# sets each request's identity with SET LOCAL inside a transaction, which is
# safe through PgBouncer's transaction mode; a session-level SET would not be.
DATABASE_URL="postgresql://app_user:...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The DIRECT (unpooled) string — same project, host without "-pooler".
# NOT read by the application, so it does not belong in Vercel. Keep it in a
# password manager: it is what pg_dump and schema changes need, because they
# use session-level features the pooler refuses.
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Each serverless instance keeps its own pool, so the real
# connection count is this times the number of warm instances.
# DATABASE_POOL_MAX="5"

# ─── sessions ───────────────────────────────────────────────────────────
# Signs the session cookie. At least 32 characters; the app refuses to start
# below that. Generate with:  openssl rand -base64 48
# Changing it signs everyone out immediately, which is also how you revoke
# every session at once if you ever need to.
SESSION_SECRET=""

# ─── push notifications ─────────────────────────────────────────────────
# Generate once and never change: a new VAPID key pair silently invalidates
# every device anyone has already registered, with no error.
#   node scripts/generate-push-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourbusiness.com"

# Must match the push_webhook_secret row in the app_settings table exactly.
PUSH_WEBHOOK_SECRET=""

# ─── tests only ─────────────────────────────────────────────────────────
# Every database test skips itself when DATABASE_URL is unset, so `npm test`
# passes while asserting nothing about the database. Set both to run them.
# ADMIN_DATABASE_URL is the OWNER connection, used only to look up rows that
# row-level security hides from the harness — never by the application.
# ADMIN_DATABASE_URL="postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
